<Window x:Class="WinDeckServer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDeck Server" Height="400" Width="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1e1e1e">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="WinDeck" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <Image x:Name="QrImage" Width="200" Height="200" Margin="0,0,0,20"/>
            <TextBlock x:Name="RoomIdText" Foreground="White" FontSize="18" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
