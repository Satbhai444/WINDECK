{
  "name": "server",
  "version": "2.4.0",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/server-lifecycle.test.js tests/desktop-main.test.js tests/desktop-ui.test.js",
    "build:css": "tailwindcss -i ./input.css -o ./public/output.css",
    "build": "npm run build:css && electron-builder --win -p never"
  },
  "build": {
    "appId": "com.windeck.server",
    "productName": "WinDeck Server",
    "directories": {
      "output": "dist-final"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Satbhai444",
        "repo": "WINDECK"
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "loudness": "^0.4.2",
    "multer": "^2.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "windows-media-sessions": "^1.0.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3",
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^45.2.3",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "jimp": "^1.6.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.2"
  }
